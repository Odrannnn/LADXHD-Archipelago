<Project Sdk="Microsoft.NET.Sdk">

  <!-- Main configuration. -->
  <PropertyGroup>
    <MonoGamePlatform>Android</MonoGamePlatform>
    <ApplicationId>com.zelda.ladxhd.archipelago</ApplicationId>
    <ApplicationDisplayVersion>$(GameVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(GameVersionCode)</ApplicationVersion>
    <TargetFramework>net9.0-android</TargetFramework>
    <RuntimeIdentifiers>android-x86;android-x64;android-arm;android-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <IsTrimmable>false</IsTrimmable>
    <EnableDefaultItems>true</EnableDefaultItems>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TelemetryEndpoint</_Parameter1>
      <_Parameter2>$(TelemetryEndpoint)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Release Builds: Most optimizations are disabled for compatibility packing multiple ABIs. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Debug Builds: Configured for debugging in emulators like Bluestacks or LDPlayer both which now support Hyper-V. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AndroidLogLevel>Debug</AndroidLogLevel>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableMarshalMethods>true</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <!-- Include the Android files that are needed. -->
  <ItemGroup>
    <AndroidManifest Include="AndroidManifest.xml" />
    <None Include="Assets\AboutAssets.txt" />
    <None Include="Resources\AboutResources.txt" />
    <AndroidResource Include="Resources\drawable\icon_foreground.xml" />
    <AndroidResource Include="Resources\drawable\splash.png" />
    <AndroidResource Include="Resources\mipmap-anydpi-v26\icon.xml" />
    <AndroidResource Include="Resources\mipmap-anydpi-v26\icon_round.xml" />
    <AndroidResource Include="Resources\values\icon_background.xml" />
    <AndroidResource Include="Resources\values\strings.xml" />
    <AndroidResource Include="Resources\values\styles.xml" />
    <AndroidResource Include="Resources\layout\splash_layout.xml" />
    <AndroidResource Include="Resources\xml\ladxhd_wallpaper.xml" />
  </ItemGroup>

  <!-- Include ProjectZ.Core which is the game data. -->
  <ItemGroup>
    <ProjectReference Include="..\ProjectZ.Core\ProjectZ.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5.1" />
    <!-- .NET Android 9 generates an invalid Java constructor for subclasses of the
         non-static WallpaperService.Engine inner class. This tiny activation stub
         supplies the required owner.super() call while all behavior stays managed. -->
    <AndroidJavaSource Remove="Java\com\zelda\ladxhd\archipelago\LadxhdWallpaperEngine.java" />
    <AndroidJavaSource Include="Java\com\zelda\ladxhd\archipelago\LadxhdWallpaperEngine.java"
                       Bind="False" />
  </ItemGroup>

  <!-- Only redistribution-safe migration inputs are bundled. The original game data is
       selected by the owner and transformed locally on the Android device. -->
  <ItemGroup>
    <AndroidAsset Include="..\..\ladxhd_patcher_source_code\Resources\patches_android.zip"
                  Link="Bootstrap\patches_android.zip" />
    <AndroidAsset Include="..\..\ladxhd_patcher_source_code\Resources\d3map"
                  Link="Bootstrap\d3map" />
    <AndroidAsset Include="..\..\ladxhd_patcher_source_code\Resources\d3mapdata"
                  Link="Bootstrap\d3mapdata" />
    <AndroidAsset Include="..\..\ladxhd_patcher_source_code\Resources\android_buttons.zip"
                  Link="Bootstrap\android_buttons.zip" />
  </ItemGroup>

  <Target Name="CopyAndroidPackageToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_SignedAndroidPackage Include="$(TargetDir)$(ApplicationId)-Signed.apk"
                             Condition="Exists('$(TargetDir)$(ApplicationId)-Signed.apk')" />
    </ItemGroup>
    <Copy SourceFiles="@(_SignedAndroidPackage)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_SignedAndroidPackage)' != ''" />
  </Target>

</Project>
