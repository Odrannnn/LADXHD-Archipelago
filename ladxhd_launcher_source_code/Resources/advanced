[Player: Link]
// Modifies various properties for Link.

//: ObjLink
// Enables sword beam on level 1 sword. Damage is scaled with current sword. 
// Default: false
swordbeam_level1 = false

//: ObjLink
// Always shoot sword beams no matter the current heart count.
// Default: false
swordbeam_always = false

//: ObjLink
// Sword charge is preserved when poking things with the sword.
// Default: false
swordpoke_keeps_charge = false

//: ObjLink
// When swimming in 2D, Roc's Feather accelerates Link in the direction of the Analog Stick or D-Pad.
// Default: false
feather_swimming2d = false

//: ObjLink
// Some objects are "instant pickup" meaning you don't need to press in the opposite direction. This option turns all objects into instant pickups.
// Default: false
bracelet_fast_pickup = false

//: ObjLink
// The time in milliseconds it takes to charge the sword for a spin slash; 500ms = 1/2 of a second.
// Default: 500
sword_charge_time = 500

//: ObjLink
// The time in milliseconds it takes to charge the boots before running; 500ms = 1/2 of a second.
// Default: 500
boots_charge_time = 500

//: ObjLink
// Jump acceleration applied when jumping with Roc's Feather. Small changes have significant impact.
// Default: 2.35
feather_velocity = 2.35

//: ObjLink
// The number of collision pixels along an edge to perform corner auto-correction. This is a feature that nudges Link to the side when pushing against the edge of collision, allowing him to sidestep and continue walking.
// Default: 2.50
corner_sidestep = 2.50

