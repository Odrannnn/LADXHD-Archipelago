[Items: Sword Shot]
// Modifies properties of the Level 2 sword shot/beam.

//: ObjSwordShot
// Base damage override of the sword beam. If set to "0" inherits the damage from sword level.
// Default: 2
swordbeam_damage = 0

//: ObjSwordShot
// The length of time that the sword beam persists. Overrides value set in "ObjLink.lahdmod".
// Default: 600
swordbeam_duration = 600

//: ObjSwordShot
// The speed at which the sword beam travels. Value is a float so decimals work here (ex: 4.55).
// Default: 4.00
swordbeam_speed = 4.00

//: ObjSwordShot
// Fires the sword beam into a 2D space.
// Default: false
swordbeam_cast2d = false

//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Items: Arrows]
// Modifies properties and lighting of Magic Rod shots. More properties for Magic Rod can be found in "ObjLink.lahdmod".

//: ObjArrow
// Base damage override of arrows. Damage is shared between arrows and bomb arrows.
// Default: 1
arrows_damage = 1

//: ObjArrow
// The distance arrows travel before falling or bomb arrow detonates. A tile is 16 pixels; default 112 = 7 tiles of distance.
// Default: 112
arrows_distance = 112

//: ObjArrow
// The speed at which arrows travel. Value is a float so decimals work here (ex: 4.55).
// Default: 3.00
arrows_speed = 3.00

//: ObjArrow
// Shoots arrows into a 2D space.
// Default: false
arrows_cast2d = false

//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Items: Bombs]
// Modifies properties of bombs. Changes properties for both player bombs or enemy bombs.

//: ObjBomb
// The time in milliseconds it takes for a bomb to explode. This only affects bombs placed by Link.
// Default: 1500
fuse_timer = 1500

//: ObjBomb
// Automatically pick up a bomb when setting down a bomb.
// Default: false
auto_pickup = false

//: ObjBomb
// Arrows can always pick up bombs as long as it's before they explode.
// Default: false
arrow_pickup = false

//: ObjBomb
// Makes items knock back bombs. Fire Rod, Hookshot, Magic Powder, etc. interact with bombs knocking them back.
// Default: false
item_interact = false

//: ObjBomb
// Interact with enemy bombs. Makes above items also interact with enemy bombs. 
// Requires the option "Knockback Bombs" option to be enabled from "Sword Modifiers" for sword knockback.
// Default: false
enemy_interact = false

//: ObjBomb
// Detonates bombs when hitting them with the Fire Rod or Magic Powder.
// Default: false
fire_detonates = false

//: ObjBomb
// Detonates bombs by pressing the bomb button after setting down a bomb.
// Default: false
remote_bombs = false

//: ObjBomb
// Link's bombs can damage both him and enemies.
// Default: false
self_damage = false

