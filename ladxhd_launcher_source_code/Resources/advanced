//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Game: Advanced Settings]
// Various options to modify the base game in some way.

//: Game1
// Forces "Editor Mode" giving access to the map editor and developer/debugging option. Usually accessed via command line option "editor" but can be enabled here too. Press "Escape" in-game to open editor.
// Default: false
editor_mode = false

//: Game1
// Allows background input from both the keyboard and controller when the game window is not in focus.
// Default: false
background_input = false

//: Game1
// Modifies the maximum scaling value available in-game. Game automatically adds +1 for the "Auto-Detect" option (so value of 50 is actually 51).
// Default: 20
max_game_scale = 20

//: Game1
// Modifies the transparency of the pixel grid when enabled. The pixel grid shader can be enabled in "Video Options" and requires "Pixel Snapping" to also be enabled. Accepts a value between 0.00 and 1.00.
// Default: 0.20
pixel_grid_alpha = 0.20

//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Game: User Interface]
// This can force the scaling value of the menus and various UI elements. It is highly recommended to use integers! 

//: OverlayManager
// Allow scrolling to nodes on the map overlay that are not yet discovered.
// Default: false
map_free_navigation = false

//: PageManager
// Menu scaling factor. Use a value of "0" to use the game value. Decimal values (like 2.50) are allowed but not recommended.
// Default: 0.00
menu_scale_override = 0.00

//: OverlayManager
// Inventory scaling factor. Use a value of "0" to use the game value. Decimal values (like 2.50) are allowed but not recommended.
// Default: 0.00
inventory_scale_override = 0.00

//: TextboxOverlay
// The scaling value used for textboxes. Use a value of "0" to use game default. This value should probably not exceed 6-10 on screens even up to 3840x2160 resolution. Decimal values (like 2.50) are allowed but not recommended.
// Default: 0.00
textbox_scale = 0.00

//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Game: HUD Overlay]
// Can enable/disable HUD elements, force a specific scaling size, and manually adjust positions of the HUD overlay. It may take a lot of manual tweaking and reloading the game to get everything exactly as you want it.

//: HUDOverlay
// Item Equipment HUD: Show/Hide with true/false or set scale and offsets. Negative values are valid. Use "0" for game default.
// Defaults: true / 0 / 0 / 0
custom_items_show = true
custom_items_scale = 0
custom_items_offsetx = 0
custom_items_offsety = 0

//: HUDOverlay
// Current Hearts HUD: Show/Hide with true/false or set scale and offsets. Negative values are valid. Use "0" for game default.
// Defaults: true / 0 / 0 / 0
custom_heart_show = true
custom_heart_scale = 0
custom_heart_offsetx = 0
custom_heart_offsety = 0

//: HUDOverlay
// Current Rupees HUD: Show/Hide with true/false or set scale and offsets. Negative values are valid. Use "0" for game default.
// Defaults: true / 0 / 0 / 0
custom_rupee_show = true
custom_rupee_scale = 0
custom_rupee_offsetx = 0
custom_rupee_offsety = 0

//: HUDOverlay
// Current Keys HUD: Show/Hide with true/false or set scale and offsets. Negative values are valid. Use "0" for game default.
// Defaults: true / 0 / 0 / 0
custom_keys_show = true
custom_keys_scale = 0
custom_keys_offsetx = 0
custom_keys_offsety = 0

//: HUDOverlay
// Save Game Icon: Show/Hide with true/false or set scale and offsets. Use "0" for game default.
// Defaults: true / 0
custom_sicon_show = true
custom_sicon_scale = 0

//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

[Camera: Advanced Settings]
// Modifies the transitioning speed of the Classic Camera when recentering. Slower values such as 0.50 more closely mimic the way the original Game Boy camera pans to a new screen.

//: Camera
// The speed at which the screen transitions from one field to another. Percentage Based: 1.00 = 100% / 0.75 = 75% / 0.50 = 50% / etc.
// Default: 1.00
classic_transition_speed = 1.00

